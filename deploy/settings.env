# Settings for our server that travel with a deploy. Nothing secret goes here:
# this file is in git. Tokens and keys go in /opt/tsps/.env on the server.
# A line here wins over the same line in the server's .env.
# What can be set: .env.example in the project folder, and server/README.md.
# A change to a REACT_APP_ line rebuilds the web client by itself.

# Accounts that are developers (the highest rank) every time they log in,
# comma-separated. Create the account in game first: a name listed here that
# nobody has registered yet belongs to whoever logs in with it first.
DEV_USERNAME=kat

# The name on the login screen's server button.
REACT_APP_DEFAULT_SERVER_NAME=TSPS
