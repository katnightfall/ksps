# Settings for our server that travel with a deploy. Nothing secret goes here:
# this file is in git. Tokens and keys go in /opt/tsps/.env on the server.
# A line here wins over the same line in the server's .env.
# What can be set: .env.example in the project folder, and server/README.md.
# A change to a REACT_APP_ line rebuilds the web client by itself.

# Accounts that are developers (the highest rank) every time they log in,
# comma-separated. Create the account in game first: a name listed here that
# nobody has registered yet belongs to whoever logs in with it first.
DEV_USERNAME="kat,mod kat"

# The name on the login screen's server button.
REACT_APP_DEFAULT_SERVER_NAME=Kat-Net

# The game connection and the game's /api addresses answer on the page's own address
# (deploy/front.mjs), so one address works, https included: https://rs.kat-net.us through
# Cloudflare, or http://<server>:3000.
REACT_APP_SAME_ORIGIN_GAME=true

# Where players reach the game directly, told to rsps.app's world list when the world is
# registered there (the token for that is in the server's .env).
WORLD_WEBSOCKET_URL=wss://rs.kat-net.us

# The master's own address, as the worlds made on its admin page (/admin) are told it: they ask
# it for the list of worlds. The admin password and the panel's keys are in the server's .env.
MASTER_PUBLIC_URL=https://rs.kat-net.us

# 1: this server is the master only and hosts no world of its own. The worlds run on the panel's
# nodes (made on the admin page); here are the website, the admin page and the carrying of their
# connections. The game service holds its port and runs nothing; the player saves stay on disk,
# untouched. 0, then deploy and "npm run remote -- restart web": the world runs here again (and
# goes back into deploy/worlds.json).
MASTER_ONLY=1
